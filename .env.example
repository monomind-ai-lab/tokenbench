# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BRANDFETCH_CLIENT_ID: Public browser-visible Brandfetch client identifier
# used only to request provider icon images. Never put a private credential here.
VITE_BRANDFETCH_CLIENT_ID="YOUR_PUBLIC_BRANDFETCH_CLIENT_ID"

# Newsletter double-opt-in configuration. Set these as Cloudflare Pages
# Function bindings; do not prefix them with VITE_ or expose private values to
# the browser.
BREVO_API_KEY="YOUR_BREVO_API_KEY"
BREVO_CHEATSHEET_LIST_ID="YOUR_BREVO_CHEATSHEET_LIST_ID"
BREVO_ALERTS_LIST_ID="YOUR_BREVO_ALERTS_LIST_ID"
BREVO_DOI_TEMPLATE_ID="YOUR_BREVO_DOI_TEMPLATE_ID"
BREVO_DOI_REDIRECT_URL="https://tokenbench.monomind.one/newsletter/confirmed/"

# Newsletter campaign-draft configuration. These values are read only by the
# local/server-side draft command; never prefix them with VITE_ or use them in
# browser code. A campaign draft is created only after separately publishing
# the manifest-listed artifacts at the supplied HTTPS base URL.
BREVO_CAMPAIGN_API_KEY="YOUR_BREVO_CAMPAIGN_API_KEY"
BREVO_CAMPAIGN_SENDER_ID="YOUR_BREVO_CAMPAIGN_SENDER_ID"
# Alternatively, omit BREVO_CAMPAIGN_SENDER_ID and set both address fields.
# BREVO_CAMPAIGN_SENDER_NAME="TokenBench"
# BREVO_CAMPAIGN_SENDER_EMAIL="news@example.com"
BREVO_CAMPAIGN_MONTHLY_CHEATSHEET_LIST_ID="YOUR_BREVO_CHEATSHEET_LIST_ID"
# Trusted Task 5 Ed25519 SPKI public key and canonical local roots. The command
# accepts only relative artifact/state paths beneath these roots.
TOKENBENCH_PUBLICATION_VERIFY_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_ED25519_SPKI_PUBLIC_KEY\n-----END PUBLIC KEY-----"
TOKENBENCH_NEWSLETTER_ARTIFACT_ROOT="/absolute/path/to/published-newsletter-artifacts"
TOKENBENCH_NEWSLETTER_STATE_ROOT="/absolute/path/to/private-newsletter-state"

# Benchmark ingestion uses only public BenchLM, LMArena, LiteLLM, and the
# already-published OpenRouter catalog snapshot. No benchmark-source API secret
# is required. The scheduled Worker must run on the Workers Paid plan because
# its atomic D1 publication batch uses the Paid-plan query allowance.
