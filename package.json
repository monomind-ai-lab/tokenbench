{
  "name": "tokenbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:guides": "tsx scripts/generate-guide-pages.ts",
    "generate:pages": "tsx scripts/generate-static-pages.ts",
    "predev": "npm run generate:pages",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run generate:pages",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:browser": "env -u FORCE_COLOR -u NO_COLOR playwright test browser-tests/responsive-browser.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "happy-dom": "^17.6.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
