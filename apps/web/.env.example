# Production decision surfaces use the separately deployed TokenBench Pages
# Functions producer. Do not point this at the Next host unless it serves the
# matching /api/benchmarks routes.
TOKENBENCH_UI_DATA_MODE=http
TOKENBENCH_UI_DATA_BASE_URL=https://your-tokenbench-data-origin.example

# The price-performance contract may share the producer origin or use an
# independently deployed validated endpoint.
TOKENBENCH_PRICE_PERFORMANCE_MODE=production
TOKENBENCH_PRICE_PERFORMANCE_BASE_URL=https://your-tokenbench-data-origin.example

# Local contract-preview mode is explicit and development-only:
# TOKENBENCH_UI_DATA_MODE=evidence
